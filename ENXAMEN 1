<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Examen Completo de Inglés - Nivel A2</title>
  <style>
    :root {
      --primary: #2c3e50;
      --secondary: #3498db;
      --accent: #e74c3c;
      --success: #27ae60;
      --warning: #f39c12;
      --bg: #f4f6f9;
      --card-bg: #ffffff;
      --text: #333333;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
      padding: 20px;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
      background: var(--card-bg);
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
      padding: 30px;
      position: relative;
    }

    header {
      text-align: center;
      border-bottom: 2px solid #eef2f5;
      padding-bottom: 20px;
      margin-bottom: 20px;
    }

    h1 {
      color: var(--primary);
      font-size: 26px;
      margin-bottom: 8px;
    }

    .level-badge {
      display: inline-block;
      background: #e8f4f8;
      color: var(--secondary);
      font-weight: bold;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 14px;
    }

    /* Security Notice */
    .security-notice {
      background-color: #fdf3d8;
      border-left: 5px solid var(--warning);
      padding: 12px 16px;
      margin-bottom: 20px;
      border-radius: 4px;
      font-size: 14px;
      color: #7d5a29;
    }

    /* Progress & Session Tabs */
    .session-indicator {
      display: flex;
      justify-content: space-between;
      margin-bottom: 25px;
      gap: 5px;
    }

    .session-tab {
      flex: 1;
      text-align: center;
      padding: 10px 5px;
      background: #eef2f5;
      color: #7f8c8d;
      font-size: 13px;
      font-weight: bold;
      border-radius: 6px;
      transition: all 0.3s ease;
    }

    .session-tab.active {
      background: var(--secondary);
      color: white;
    }

    .session-tab.completed {
      background: var(--success);
      color: white;
    }

    .progress-bar-container {
      width: 100%;
      height: 8px;
      background: #eef2f5;
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 25px;
    }

    .progress-bar {
      height: 100%;
      width: 20%;
      background: var(--secondary);
      transition: width 0.3s ease;
    }

    /* Form Content */
    .session-block {
      display: none;
    }

    .session-block.active {
      display: block;
    }

    .section-title {
      font-size: 20px;
      color: var(--primary);
      margin-bottom: 15px;
      padding-bottom: 5px;
      border-bottom: 1px solid #ddd;
    }

    .question {
      background: #fdfdfd;
      border: 1px solid #eef2f5;
      padding: 18px;
      border-radius: 8px;
      margin-bottom: 20px;
    }

    .question p {
      font-weight: 600;
      margin-bottom: 12px;
      color: #2c3e50;
    }

    .options label {
      display: block;
      padding: 10px 14px;
      margin-bottom: 8px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 6px;
      cursor: pointer;
      transition: background 0.2s;
    }

    .options label:hover {
      background: #edf2f7;
    }

    .options input[type="radio"] {
      margin-right: 10px;
    }

    input[type="text"], input[type="password"] {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      font-size: 15px;
    }

    select {
      width: 100%;
      padding: 10px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      background-color: white;
      font-size: 14px;
    }

    .match-row {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 15px;
    }

    @media (min-width: 600px) {
      .match-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
      }
      .match-row span {
        width: 55%;
      }
      .match-row select {
        width: 40%;
      }
    }

    /* Buttons */
    .nav-buttons {
      display: flex;
      justify-content: space-between;
      margin-top: 30px;
      gap: 15px;
    }

    button {
      padding: 12px 24px;
      border: none;
      border-radius: 6px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-prev {
      background-color: #95a5a6;
      color: white;
    }

    .btn-prev:hover {
      background-color: #7f8c8d;
    }

    .btn-next {
      background-color: var(--secondary);
      color: white;
    }

    .btn-next:hover {
      background-color: #2980b9;
    }

    .btn-submit {
      background-color: var(--success);
      color: white;
    }

    .btn-submit:hover {
      background-color: #219150;
    }

    /* Results */
    #results {
      display: none;
      text-align: center;
      padding: 25px;
      background: #f8fafc;
      border-radius: 8px;
      margin-top: 20px;
    }

    .score-display {
      font-size: 32px;
      font-weight: bold;
      margin: 15px 0;
    }

    /* Lock Overlay Screen */
    #lockOverlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background-color: rgba(44, 62, 80, 0.98);
      z-index: 9999;
      color: white;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 30px;
    }

    #lockOverlay h2 {
      font-size: 36px;
      color: var(--accent);
      margin-bottom: 15px;
    }

    #lockOverlay p {
      font-size: 16px;
      max-width: 600px;
      margin-bottom: 15px;
    }

    .teacher-box {
      background: rgba(255, 255, 255, 0.1);
      padding: 20px;
      border-radius: 8px;
      margin-top: 15px;
      width: 100%;
      max-width: 380px;
    }

    .teacher-box input {
      margin-bottom: 12px;
      text-align: center;
      font-size: 16px;
    }

    #unlockBtn {
      background-color: var(--accent);
      color: white;
      width: 100%;
      padding: 12px;
      font-size: 16px;
    }

    #unlockBtn:hover {
      background-color: #c0392b;
    }

    .error-msg {
      color: #ff6b6b;
      font-size: 14px;
      margin-top: 8px;
      display: none;
    }
  </style>
</head>
<body>

  <!-- Screen Lock Overlay -->
  <div id="lockOverlay">
    <h2>⚠️ Examen Bloqueado</h2>
    <p>Has salido de la ventana o cambiado de pestaña durante la sesión de prueba. Por motivos de seguridad anti-fraude, la sesión ha sido suspendida.</p>
    <p><strong>Intentos de salida detectados: <span id="violationCount">0</span></strong></p>
    
    <div class="teacher-box">
      <p style="font-size: 14px; margin-bottom: 10px;">Llama a tu docente para desbloquear el examen:</p>
      <input type="password" id="teacherCodeInput" placeholder="Código de acceso docente">
      <button id="unlockBtn" onclick="resumeExam()">Desbloquear Examen</button>
      <div id="errorMsg" class="error-msg">Código incorrecto. Solicita asistencia al docente.</div>
    </div>
  </div>

  <div class="container">
    <header>
      <h1>Examen General de Inglés</h1>
      <span class="level-badge">Nivel A2 (Básico Elemental)</span>
    </header>

    <div class="security-notice">
      🔒 <strong>Atención:</strong> Este examen cuenta con monitorización en tiempo real. Si cambias de pestaña, minimizas o sales del navegador, el examen se bloqueará y requerirá la clave del profesor para continuar.
    </div>

    <!-- Session Navigation Tabs -->
    <div class="session-indicator">
      <div class="session-tab active" id="tab-1">Sesión 1</div>
      <div class="session-tab" id="tab-2">Sesión 2</div>
      <div class="session-tab" id="tab-3">Sesión 3</div>
      <div class="session-tab" id="tab-4">Sesión 4</div>
      <div class="session-tab" id="tab-5">Sesión 5</div>
    </div>

    <div class="progress-bar-container">
      <div class="progress-bar" id="progressBar"></div>
    </div>

    <form id="quizForm">

      <!-- SESIÓN 1 -->
      <div class="session-block active" id="session-1">
        <h2 class="section-title">Sesión 1: Gramática y Tiempos Verbales Básicos (A2)</h2>

        <div class="question">
          <p>1. Yesterday, Mary _____ to the supermarket to buy some fruits.</p>
          <div class="options">
            <label><input type="radio" name="q1" value="A"> A) go</label>
            <label><input type="radio" name="q1" value="B"> B) went</label>
            <label><input type="radio" name="q1" value="C"> C) is going</label>
            <label><input type="radio" name="q1" value="D"> D) has gone</label>
          </div>
        </div>

        <div class="question">
          <p>2. If it rains tomorrow, we _____ stay at home.</p>
          <div class="options">
            <label><input type="radio" name="q12_a2" value="A" name="q2"> A) will</label>
            <label><input type="radio" name="q2" value="B"> B) would</label>
            <label><input type="radio" name="q2" value="C"> C) did</label>
            <label><input type="radio" name="q2" value="D"> D) were</label>
          </div>
        </div>

        <div class="question">
          <p>3. Look at the dark clouds! It _____ rain in a few minutes.</p>
          <div class="options">
            <label><input type="radio" name="q3" value="A"> A) is going to</label>
            <label><input type="radio" name="q3" value="B"> B) rained</label>
            <label><input type="radio" name="q3" value="C"> C) goes to</label>
            <label><input type="radio" name="q3" value="D"> D) was</label>
          </div>
        </div>

        <div class="question">
          <p>4. While I was studying, my brother _____ music loudly.</p>
          <div class="options">
            <label><input type="radio" name="q4" value="A"> A) plays</label>
            <label><input type="radio" name="q4" value="B"> B) was playing</label>
            <label><input type="radio" name="q4" value="C"> C) is playing</label>
            <label><input type="radio" name="q4" value="D"> D) play</label>
          </div>
        </div>

        <div class="question">
          <p>5. Have you ever _____ pizza in Italy?</p>
          <div class="options">
            <label><input type="radio" name="q5" value="A"> A) eat</label>
            <label><input type="radio" name="q5" value="B"> B) eaten</label>
            <label><input type="radio" name="q5" value="C"> C) ate</label>
            <label><input type="radio" name="q5" value="D"> D) eating</label>
          </div>
        </div>
      </div>

      <!-- SESIÓN 2 -->
      <div class="session-block" id="session-2">
        <h2 class="section-title">Sesión 2: Reorganización Oracional (A2)</h2>
        <p style="margin-bottom: 15px; font-size: 14px; color: #666;">Escribe la oración ordenada correctamente, manteniendo puntuación y mayúsculas adecuadas:</p>

        <div class="question">
          <p>6. Ordena: <em>always / She / early / gets up / in the morning.</em></p>
          <input type="text" id="q6" placeholder="Escribe la oración completa aquí...">
        </div>

        <div class="question">
          <p>7. Ordena: <em>the bank / Where / located / is / ?</em></p>
          <input type="text" id="q7" placeholder="Escribe la pregunta completa aquí...">
        </div>

        <div class="question">
          <p>8. Ordena: <em>are / going to / We / travel / next week.</em></p>
          <input type="text" id="q8" placeholder="Escribe la oración completa aquí...">
        </div>

        <div class="question">
          <p>9. Ordena: <em>played / They / soccer / yesterday. / in the park</em></p>
          <input type="text" id="q9" placeholder="Escribe la oración completa aquí...">
        </div>

        <div class="question">
          <p>10. Ordena: <em>more expensive / My car / is / than / yours.</em></p>
          <input type="text" id="q10" placeholder="Escribe la oración completa aquí...">
        </div>
      </div>

      <!-- SESIÓN 3 -->
      <div class="session-block" id="session-3">
        <h2 class="section-title">Sesión 3: Expresiones y Phrasal Verbs Básicos (A2)</h2>
        <p style="margin-bottom: 15px; font-size: 14px; color: #666;">Selecciona la opción que complete el significado de cada frase:</p>

        <div class="match-row question">
          <span style="font-weight: 500;">11. Before going to bed, please don't forget to...</span>
          <select id="q11">
            <option value="">-- Selecciona la opción --</option>
            <option value="A">turn off the lights.</option>
            <option value="B">grow up quickly.</option>
            <option value="C">take off the train.</option>
          </select>
        </div>

        <div class="match-row question">
          <span style="font-weight: 500;">12. When you enter a house in Japan, you must...</span>
          <select id="q12">
            <option value="">-- Selecciona la opción --</option>
            <option value="A">take off your shoes.</option>
            <option value="B">look for your shoes.</option>
            <option value="C">fill in your shoes.</option>
          </select>
        </div>

        <div class="match-row question">
          <span style="font-weight: 500;">13. If you don't know the meaning of a word, you can...</span>
          <select id="q13">
            <option value="">-- Selecciona la opción --</option>
            <option value="A">look it up in a dictionary.</option>
            <option value="B">get up early tomorrow.</option>
            <option value="C">turn down the volume.</option>
          </select>
        </div>

        <div class="match-row question">
          <span style="font-weight: 500;">14. My alarm clock rings at 6:00 AM every day to...</span>
          <select id="q14">
            <option value="">-- Selecciona la opción --</option>
            <option value="A">wake me up for work.</option>
            <option value="B">give up the game.</option>
            <option value="C">find out the answer.</option>
          </select>
        </div>

        <div class="match-row question">
          <span style="font-weight: 500;">15. I have a great relationship with my sister; we...</span>
          <select id="q15">
            <option value="">-- Selecciona la opción --</option>
            <option value="A">get along very well.</option>
            <option value="B">go back to school.</option>
            <option value="C">put on our coats.</option>
          </select>
        </div>
      </div>

      <!-- SESIÓN 4 -->
      <div class="session-block" id="session-4">
        <h2 class="section-title">Sesión 4: Lectura Breve y Orden Lógico (A2)</h2>
        <div style="background: #eef2f5; padding: 15px; border-radius: 6px; margin-bottom: 20px; font-style: italic; font-size: 14.5px;">
          "Tom usually works in an office, but today he is working from home. He likes working from home because he can save time and spend more time with his dog. However, sometimes he misses talking with his coworkers."
        </div>

        <div class="question">
          <p>16. Why does Tom like working from home today?</p>
          <div class="options">
            <label><input type="radio" name="q16" value="A"> A) Because he doesn't like his coworkers.</label>
            <label><input type="radio" name="q16" value="B"> B) Because he can save time and be with his dog.</label>
            <label><input type="radio" name="q16" value="C"> C) Because he buys a new office.</label>
            <label><input type="radio" name="q16" value="D"> D) Because he works in a dog shop.</label>
          </div>
        </div>

        <div class="question">
          <p>17. What does the word <strong>"coworkers"</strong> mean in this text?</p>
          <div class="options">
            <label><input type="radio" name="q17" value="A"> A) Family members</label>
            <label><input type="radio" name="q17" value="B"> B) People you work with</label>
            <label><input type="radio" name="q17" value="C"> C) Pets</label>
            <label><input type="radio" name="q17" value="D"> D) Students</label>
          </div>
        </div>

        <p style="margin: 20px 0 10px 0; font-weight: bold;">Asigna el número de orden (1 a 3) a las siguientes oraciones para formar una historia diaria coherente:</p>

        <div class="question">
          <p>18. Secuencia - Frase A:
            <select id="q18_1" style="width: auto; display: inline-block; margin-right: 10px;">
              <option value="">-</option><option value="1">1</option><option value="2">2</option><option value="3">3</option>
            </select>
            After that, I take a shower and have breakfast with my family.
          </p>
          <p>19. Secuencia - Frase B:
            <select id="q18_2" style="width: auto; display: inline-block; margin-right: 10px;">
              <option value="">-</option><option value="1">1</option><option value="2">2</option><option value="3">3</option>
            </select>
            First, I wake up at 6:30 AM every morning.
          </p>
          <p>20. Secuencia - Frase C:
            <select id="q18_3" style="width: auto; display: inline-block; margin-right: 10px;">
              <option value="">-</option><option value="1">1</option><option value="2">2</option><option value="3">3</option>
            </select>
            Finally, I leave the house and take the bus to go to work.
          </p>
        </div>
      </div>

      <!-- SESIÓN 5 -->
      <div class="session-block" id="session-5">
        <h2 class="section-title">Sesión 5: Modales, Conectores Básicos y Comparativos (A2)</h2>

        <div class="question">
          <p>21. You _____ wear a helmet when riding a motorbike. It's the law!</p>
          <div class="options">
            <label><input type="radio" name="q21" value="A"> A) can</label>
            <label><input type="radio" name="q21" value="B"> B) must</label>
            <label><input type="radio" name="q21" value="C"> C) should to</label>
            <label><input type="radio" name="q21" value="D"> D) might</label>
          </div>
        </div>

        <div class="question">
          <p>22. Peter wanted to go to the beach, _____ it started raining heavily.</p>
          <div class="options">
            <label><input type="radio" name="q22" value="A"> A) because</label>
            <label><input type="radio" name="q22" value="B"> B) but</label>
            <label><input type="radio" name="q22" value="C"> C) so</label>
            <label><input type="radio" name="q22" value="D"> D) or</label>
          </div>
        </div>

        <div class="question">
          <p>23. English is _____ than Chinese for many Spanish speakers.</p>
          <div class="options">
            <label><input type="radio" name="q23" value="A"> A) easier</label>
            <label><input type="radio" name="q23" value="B"> B) more easy</label>
            <label><input type="radio" name="q23" value="C"> C) easiest</label>
            <label><input type="radio" name="q23" value="D"> D) easy</label>
          </div>
        </div>

        <div class="question">
          <p>24. She likes playing tennis, _____ she doesn't like playing basketball.</p>
          <div class="options">
            <label><input type="radio" name="q24" value="A"> A) although</label>
            <label><input type="radio" name="q24" value="B"> B) because</label>
            <label><input type="radio" name="q24" value="C"> C) so</label>
            <label><input type="radio" name="q24" value="D"> D) while</label>
          </div>
        </div>

        <div class="question">
          <p>25. I am planning _____ a new computer next month.</p>
          <div class="options">
            <label><input type="radio" name="q25" value="A"> A) buying</label>
            <label><input type="radio" name="q25" value="B"> B) to buy</label>
            <label><input type="radio" name="q25" value="C"> C) buy</label>
            <label><input type="radio" name="q25" value="D"> D) bought</label>
          </div>
        </div>
      </div>

      <!-- Navigation buttons -->
      <div class="nav-buttons">
        <button type="button" class="btn-prev" id="prevBtn" onclick="changeSession(-1)" style="display: none;">Anterior</button>
        <button type="button" class="btn-next" id="nextBtn" onclick="changeSession(1)">Siguiente Sesión</button>
        <button type="button" class="btn-submit" id="submitBtn" onclick="evaluateQuiz()" style="display: none;">Finalizar Examen</button>
      </div>

    </form>

    <div id="results"></div>
  </div>

  <script>
    let currentSession = 1;
    const totalSessions = 5;
    let lockViolations = 0;
    let isLocked = false;

    // CLAVE DE DESBLOQUEO DOCENTE
    const TEACHER_PIN = "DOCENTE2026";

    // Load saved answers from LocalStorage
    window.addEventListener('DOMContentLoaded', () => {
      loadProgress();
      updateNavigation();
      initAntiCheat();
    });

    // Session Switcher
    function changeSession(step) {
      saveProgress();

      // Hide current session
      document.getElementById(`session-${currentSession}`).classList.remove('active');
      document.getElementById(`tab-${currentSession}`).classList.remove('active');
      document.getElementById(`tab-${currentSession}`).classList.add('completed');

      currentSession += step;

      // Show new session
      document.getElementById(`session-${currentSession}`).classList.add('active');
      document.getElementById(`tab-${currentSession}`).classList.add('active');

      updateNavigation();
    }

    function updateNavigation() {
      const prevBtn = document.getElementById('prevBtn');
      const nextBtn = document.getElementById('nextBtn');
      const submitBtn = document.getElementById('submitBtn');
      const progressBar = document.getElementById('progressBar');

      // Update progress bar
      progressBar.style.width = `${(currentSession / totalSessions) * 100}%`;

      // Button states
      if (currentSession === 1) {
        prevBtn.style.display = 'none';
      } else {
        prevBtn.style.display = 'block';
      }

      if (currentSession === totalSessions) {
        nextBtn.style.display = 'none';
        submitBtn.style.display = 'block';
      } else {
        nextBtn.style.display = 'block';
        submitBtn.style.display = 'none';
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Anti-Cheat & Screen Locking System
    function initAntiCheat() {
      // Visibility change (tab switching)
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          triggerLock();
        }
      });

      // Blur event (window focus lost)
      window.addEventListener('blur', () => {
        triggerLock();
      });
    }

    function triggerLock() {
      if (isLocked) return;
      isLocked = true;
      lockViolations++;

      document.getElementById('violationCount').innerText = lockViolations;
      document.getElementById('teacherCodeInput').value = '';
      document.getElementById('errorMsg').style.display = 'none';
      document.getElementById('lockOverlay').style.display = 'flex';
      saveProgress();
    }

    function resumeExam() {
      const inputCode = document.getElementById('teacherCodeInput').value;
      if (inputCode === TEACHER_PIN) {
        isLocked = false;
        document.getElementById('lockOverlay').style.display = 'none';
        document.getElementById('errorMsg').style.display = 'none';
      } else {
        document.getElementById('errorMsg').style.display = 'block';
      }
    }

    // Save and Load State
    function saveProgress() {
      const formData = new FormData(document.getElementById('quizForm'));
      const data = {};
      for (let [key, val] of formData.entries()) {
        data[key] = val;
      }

      // Add text and select inputs
      const textInputs = document.querySelectorAll('input[type="text"], select');
      textInputs.forEach(input => {
        if (input.id) data[input.id] = input.value;
      });

      localStorage.setItem('english_exam_data_a2', JSON.stringify(data));
      localStorage.setItem('english_exam_session_a2', currentSession);
    }

    function loadProgress() {
      const savedData = localStorage.getItem('english_exam_data_a2');
      if (!savedData) return;

      const data = JSON.parse(savedData);

      // Restore radio buttons
      Object.keys(data).forEach(name => {
        const radio = document.querySelector(`input[name="${name}"][value="${data[name]}"]`);
        if (radio) radio.checked = true;

        const input = document.getElementById(name);
        if (input) input.value = data[name];
      });
    }

    // Evaluation Logic
    function evaluateQuiz() {
      saveProgress();
      let score = 0;
      const totalQuestions = 25;

      // Section 1: Multiple Choice
      if (getRadioValue('q1') === 'B') score++;
      if (getRadioValue('q2') === 'A') score++;
      if (getRadioValue('q3') === 'A') score++;
      if (getRadioValue('q4') === 'B') score++;
      if (getRadioValue('q5') === 'B') score++;

      // Section 2: Sentence Ordering
      const q6 = cleanText(document.getElementById('q6').value);
      if (q6 === 'she always gets up early in the morning.') score++;

      const q7 = cleanText(document.getElementById('q7').value);
      if (q7 === 'where is the bank located?') score++;

      const q8 = cleanText(document.getElementById('q8').value);
      if (q8 === 'we are going to travel next week.') score++;

      const q9 = cleanText(document.getElementById('q9').value);
      if (q9 === 'they played soccer in the park yesterday.' || q9 === 'they played soccer yesterday in the park.') score++;

      const q10 = cleanText(document.getElementById('q10').value);
      if (q10 === 'my car is more expensive than yours.') score++;

      // Section 3: Phrasal Verbs & Expressions
      if (document.getElementById('q11').value === 'A') score++;
      if (document.getElementById('q12').value === 'A') score++;
      if (document.getElementById('q13').value === 'A') score++;
      if (document.getElementById('q14').value === 'A') score++;
      if (document.getElementById('q15').value === 'A') score++;

      // Section 4: Reading & Logic
      if (getRadioValue('q16') === 'B') score++;
      if (getRadioValue('q17') === 'B') score++;

      const s1 = document.getElementById('q18_1').value;
      const s2 = document.getElementById('q18_2').value;
      const s3 = document.getElementById('q18_3').value;
      if (s1 === '2' && s2 === '1' && s3 === '3') score++;

      // Section 5: Modals, Connectors & Grammar
      if (getRadioValue('q21') === 'B') score++;
      if (getRadioValue('q22') === 'B') score++;
      if (getRadioValue('q23') === 'A') score++;
      if (getRadioValue('q24') === 'A') score++;
      if (getRadioValue('q25') === 'B') score++;

      // Display Results
      const percentage = ((score / totalQuestions) * 100).toFixed(1);
      const resultsDiv = document.getElementById('results');
      resultsDiv.style.display = 'block';

      let statusColor = percentage >= 70 ? '#27ae60' : '#e74c3c';
      let message = percentage >= 70
        ? "¡Felicidades! Has demostrado un dominio sólido del nivel A2."
        : "Revisa los contenidos básicos e inténtalo de nuevo para consolidar tu nivel.";

      resultsDiv.innerHTML = `
        <h2>Resultado del Examen</h2>
        <div class="score-display" style="color: ${statusColor};">${score} / ${totalQuestions} (${percentage}%)</div>
        <p>${message}</p>
        <p style="font-size: 13px; color: #7f8c8d; margin-top: 10px;">Incidentes de salida de pantalla registrados: ${lockViolations}</p>
      `;

      window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
    }

    function getRadioValue(name) {
      const selected = document.querySelector(`input[name="${name}"]:checked`);
      return selected ? selected.value : null;
    }

    function cleanText(text) {
      return text.trim().toLowerCase().replace(/\s+/g, ' ');
    }
  </script>
</body>
